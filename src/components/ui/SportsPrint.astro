---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tape from './Tape.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  event: string;
  date: string;
  section?: string;
  row?: string;
  tape?: { left: number; rotate: number };
}

const { image, alt, event, date, section, row, tape } = Astro.props;

// "DATE / SEC 12 ROW 4". Seat details are optional and only shown when provided.
const seat = [section && `SEC ${section}`, row && `ROW ${row}`].filter(Boolean).join(' ');
const detail = seat ? `${date} / ${seat}` : date;
---

<figure class="sports">
  {tape && <Tape left={tape.left} rotate={tape.rotate} width={76} height={22} />}
  <div class="frame">
    <Image src={image} alt={alt} width={600} height={380} class="photo" />
  </div>
  <!-- Ticket stub caption. It counter-rotates against the print (via --r from the parent) so it sits level. -->
  <figcaption class="stub">
    {event}
    <br />
    {detail}
  </figcaption>
</figure>

<style>
  .sports {
    position: relative;
    margin: 0;
  }

  .frame {
    padding: 10px;
    background-color: var(--print);
    border: var(--border-thin);
    box-shadow: var(--shadow-soft);
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 300 / 190;
    object-fit: cover;
  }

  .stub {
    position: relative;
    box-sizing: border-box;
    width: 71.9%;
    margin: -4px 0 0 11.25%;
    padding: var(--space-2) 14px;
    background-color: var(--print);
    border: 1.5px dashed var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    text-transform: uppercase;
    transform: rotate(calc(var(--r, 0deg) * -1));
  }
</style>
