---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tape from './Tape.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  artist: string;
  album: string;
  tape?: { left: number; rotate: number };
}

const { image, alt, artist, album, tape } = Astro.props;
---

<figure class="album">
  {tape && <Tape left={tape.left} rotate={tape.rotate} width={66} height={20} />}
  <Image src={image} alt={alt} width={300} height={300} class="cover" />
  <figcaption>
    {artist}
    <br />
    {album}
  </figcaption>
</figure>

<style>
  .album {
    position: relative;
    margin: 0;
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    box-sizing: border-box;
    border: var(--border-thin);
    box-shadow: var(--shadow-soft);
  }

  figcaption {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.3;
    text-transform: uppercase;
  }
</style>
