---
interface Props {
  /** Offsets and size in px, relative to the nearest positioned parent. */
  left?: number;
  top?: number;
  width?: number;
  height?: number;
  rotate?: number;
  variant?: 'accent' | 'light';
}

const { left = 0, top = -12, width = 72, height = 22, rotate = 0, variant = 'accent' } = Astro.props;
---

<span
  class:list={['tape', variant]}
  style={`left:${left}px;top:${top}px;width:${width}px;height:${height}px;transform:rotate(${rotate}deg)`}
  aria-hidden="true"></span>

<style>
  .tape {
    position: absolute;
    z-index: 1;
  }

  .accent {
    background-color: var(--tape);
  }

  .light {
    background-color: var(--tape-light);
    border: 1px solid var(--ink-20);
  }
</style>
