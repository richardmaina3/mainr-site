---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tape from './Tape.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  artist: string;
  title: string;
  /** Omit, or leave blank, when the year is not known. */
  year?: string;
  tape?: { left: number; rotate: number };
}

const { image, alt, artist, title, year, tape } = Astro.props;
---

<figure class="museum">
  {tape && <Tape left={tape.left} rotate={tape.rotate} width={72} height={22} />}
  <div class="frame">
    <Image src={image} alt={alt} width={380} height={480} class="photo" />
  </div>
  <!-- Museum placard: Artist, Title (italic), Year. -->
  <figcaption class="placard">
    {artist}
    <br />
    <em>{title}</em>{year ? `, ${year}` : ''}
  </figcaption>
</figure>

<style>
  .museum {
    position: relative;
    margin: 0;
  }

  .frame {
    padding: 10px;
    background-color: var(--print);
    border: var(--border-thin);
    box-shadow: var(--shadow-soft);
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 190 / 240;
    object-fit: cover;
  }

  /* Sizes are percentages of the print so the placard scales with it. */
  .placard {
    box-sizing: border-box;
    width: 71.43%;
    margin: var(--space-2) 0 0 6.67%;
    padding: 6px var(--space-2);
    background-color: var(--print);
    border: 1px solid var(--ink);
    font-size: 11px;
    line-height: 1.3;
  }
</style>
