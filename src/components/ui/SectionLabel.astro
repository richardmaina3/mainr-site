---
import { getEntry } from 'astro:content';

interface Props {
  /** Section id from site.json `nav` (e.g. "work"). Position and label come from there. */
  id: string;
  /** Use `h2` when the label is the section's heading, `p` when a larger title follows. */
  as?: 'h2' | 'p';
}

const { id, as: Tag = 'p' } = Astro.props;

const site = (await getEntry('site', 'site'))!.data;
const index = site.nav.findIndex((item) => item.id === id);
if (index < 0) {
  throw new Error(`SectionLabel: "${id}" is not listed in site.json "nav".`);
}
const text = `${String(index + 1).padStart(2, '0')} / ${site.nav[index].label.toUpperCase()}`;
---

<Tag class="label">{text}</Tag>

<style>
  .label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.08em;
  }
</style>
