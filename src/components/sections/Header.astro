---
import { getEntry } from 'astro:content';
import PillButton from '../ui/PillButton.astro';

const site = (await getEntry('site', 'site'))!.data;
---

<header class="page header">
  <div class="bar">
    <!-- Decorative coordinate readout, a nod to the notebook-page concept. It sits with the header; the script below makes it follow the pointer. -->
    <div class="coords" aria-hidden="true"><span>X 002.00</span><span>Y 014.00</span></div>

    <nav class="nav" aria-label="Primary">
      <!-- 700px and up: links sit inline in the box. -->
      <div class="links">
        {site.nav.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
      </div>

      <PillButton href={`mailto:${site.email}`} size="sm">{site.ctaPrimary}</PillButton>

      <!-- Below 700px: a native disclosure (works without JS) holds the section links. -->
      <details class="menu">
        <summary aria-label="Menu">
          <svg class="icon icon-closed" width="21" height="21" viewBox="0 0 7 7" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
            <path d="M1 1h5v1h-5z M1 3h5v1h-5z M1 5h5v1h-5z"></path>
          </svg>
          <svg class="icon icon-open" width="21" height="21" viewBox="0 0 7 7" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
            <path d="M1 1h1v1h-1z M5 1h1v1h-1z M2 2h1v1h-1z M4 2h1v1h-1z M3 3h1v1h-1z M2 4h1v1h-1z M4 4h1v1h-1z M1 5h1v1h-1z M5 5h1v1h-1z"></path>
          </svg>
        </summary>
        <ul class="panel">
          {site.nav.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  // Close the mobile menu after choosing a section, or on Escape. Everything else is native.
  const menu = document.querySelector<HTMLDetailsElement>('.header .menu');
  if (menu) {
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }

  // Coordinate readout: where the pointer is on the page, in 16px grid squares (the hairline grid).
  // Only for a real pointer, and not when the visitor prefers reduced motion; otherwise it stays static.
  const coords = document.querySelector<HTMLElement>('.header .coords');
  if (coords && matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    const [x, y] = coords.children;
    let px = 0;
    let py = 0;
    let moved = false;
    let frame = 0;
    const fmt = (value: number, max: number) => (Math.min(Math.max(value, 0), max) / 16).toFixed(2).padStart(6, '0');
    const draw = () => {
      frame = 0;
      const { scrollWidth, scrollHeight } = document.documentElement;
      x.textContent = 'X ' + fmt(px + scrollX, scrollWidth);
      y.textContent = 'Y ' + fmt(py + scrollY, scrollHeight);
    };
    const queue = () => {
      if (moved && !frame) frame = requestAnimationFrame(draw);
    };
    addEventListener(
      'pointermove',
      (event) => {
        px = event.clientX;
        py = event.clientY;
        moved = true;
        queue();
      },
      { passive: true },
    );
    addEventListener('scroll', queue, { passive: true });
  }
</script>

<style>
  .header {
    position: relative;
    /* Above the hero's scrapbook pieces so the open menu is never covered. */
    z-index: 20;
    padding-top: var(--page-pad);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 56px;
  }

  .coords {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.04em;
  }

  .coords span {
    display: block;
  }

  .nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 28px;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-5);
    background-color: var(--print);
    border: var(--border-thin);
  }

  /*
    Bigger hit areas with no visual change: each link gets 16px x 8px of padding, offset by
    equal negative margins, so the layout and the 28px text spacing stay exactly as designed.
  */
  .links {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-inline: -8px;
  }

  .links a {
    padding: 16px 8px;
    margin-block: -8px;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-decoration: none;
  }

  .menu {
    display: none;
  }

  /* Phones: readout hidden, the box fills the row, links move into the menu. */
  @media (max-width: 699px) {
    .bar {
      grid-template-columns: 1fr;
    }

    .coords,
    .links {
      display: none;
    }

    .nav {
      justify-content: space-between;
      gap: var(--space-3);
      padding: var(--space-2);
    }

    .menu {
      display: block;
    }

    /* Square toggle that borrows the pill's look and its hover and focus treatment. */
    summary {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      box-sizing: border-box;
      border: var(--border-thick);
      background-color: var(--print);
      color: var(--ink);
      box-shadow: var(--shadow-btn);
      cursor: pointer;
      list-style: none;
      transition:
        transform var(--transition-hover),
        box-shadow var(--transition-hover),
        background-color var(--transition-hover),
        color var(--transition-hover);
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary:hover,
    summary:focus-visible {
      transform: translate(-1px, -1px);
      box-shadow: var(--shadow-btn-hover);
      background-color: var(--accent-deep);
      color: var(--print);
    }

    .icon-open,
    .menu[open] .icon-closed {
      display: none;
    }

    .menu[open] .icon-open {
      display: block;
    }

    .panel {
      position: absolute;
      top: calc(100% + var(--space-2));
      left: -1.5px;
      right: -1.5px;
      margin: 0;
      padding: 0;
      list-style: none;
      background-color: var(--print);
      border: var(--border-thin);
      box-shadow: var(--shadow-window);
    }

    .panel li + li {
      border-top: 1px solid var(--ink-20);
    }

    .panel a {
      display: block;
      padding: var(--space-4);
      font-family: var(--font-mono);
      font-size: var(--text-body);
      text-decoration: none;
    }
  }
</style>
